# 复制为 .env（已被 .gitignore 忽略），填入真实值后即可本地测试。
# 真实 shell 环境变量优先于本文件；也支持 TRENDRADAR_ENV_FILE 指定其他路径。

# DeepSeek 官方（magpie 的 provider 配置里也有同名项）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# `trendradar run` 的 config.yaml 可写成 ${DEEPSEEK_API_KEY} / ${DEEPSEEK_MODEL}
# 等方式引用这些变量，避免把密钥写进仓库。
# 示例：
#   model:
#     provider: deepseek
#     name: ${DEEPSEEK_MODEL}
#     baseURL: ${DEEPSEEK_BASE_URL}
#     apiKey: ${DEEPSEEK_API_KEY}

# GitHub token（可选）
GITHUB_TOKEN=
GITHUB_READ_TOKEN=
