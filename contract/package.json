{
  "name": "@morehao/trendradar-contract",
  "version": "0.2.0",
  "description": "Language-neutral contract (JSON Schema, fixtures, generated Go & TypeScript types) shared by the trendradar Go core and its DSH plugin.",
  "type": "module",
  "license": "MIT",
  "files": [
    "schema",
    "fixtures",
    "gen/ts",
    "version-map.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./gen/ts/index.d.ts",
      "import": "./gen/ts/index.js"
    },
    "./schema/*": "./schema/*",
    "./fixtures/*": "./fixtures/*"
  },
  "types": "./gen/ts/index.d.ts",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "verify": "node scripts/generate.mjs && git diff --exit-code -- gen contract.gen.go schema",
    "verify-versions": "node scripts/check-versions.mjs",
    "verify-field-map": "node scripts/check-field-map.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run verify-versions && npm run verify-field-map"
  },
  "devDependencies": {
    "canonicalize": "5.1.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
