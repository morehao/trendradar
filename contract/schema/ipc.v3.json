{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/morehao/trendradar/contract/schema/ipc.v3.json",
  "title": "trendradar ipc v3",
  "description": "Envelope exchanged between the trendradar core binary and the DSH plugin. Only RunRequest forbids extra fields. ipcSchema is const 3.",
  "oneOf": [
    {
      "$ref": "#/$defs/RunRequest"
    },
    {
      "$ref": "#/$defs/RunResult"
    }
  ],
  "$defs": {
    "ErrorCode": {
      "type": "string",
      "enum": [
        "INTERNAL",
        "CONFIG_INVALID",
        "PAYLOAD_TOO_LARGE",
        "FETCH_FAILED",
        "FETCH_RATE_LIMITED",
        "PARSE_FAILED",
        "MODEL_UNAUTHORIZED",
        "MODEL_RATE_LIMITED",
        "MODEL_TIMEOUT",
        "MODEL_FAILED",
        "MODEL_BAD_OUTPUT",
        "GIT_NOT_INSTALLED",
        "REPO_NOT_GIT",
        "REPO_DIRTY",
        "GIT_OPERATION_FAILED",
        "PR_FAILED",
        "NOT_MERGEABLE"
      ]
    },
    "ErrorInfo": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "code",
        "message",
        "retriable"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "retriable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "FileArtifact": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string"
        }
      }
    },
    "DigestArtifact": {
      "type": "object",
      "additionalProperties": true,
      "description": "The digest document rendered by this run, inlined so the caller never reads the output repository. bytes/sha256 describe the UTF-8 bytes of text exactly as written to path.",
      "required": [
        "path",
        "bytes",
        "sha256",
        "text"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "text": {
          "type": "string",
          "maxLength": 1048576
        }
      }
    },
    "RunRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ipcSchema",
        "command"
      ],
      "properties": {
        "ipcSchema": {
          "const": 3
        },
        "command": {
          "type": "string",
          "enum": [
            "run",
            "serve",
            "config",
            "version",
            "subscribe"
          ]
        },
        "configPath": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "dryRun": {
          "type": "boolean"
        },
        "outputDir": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": [
            "list",
            "add",
            "remove",
            "releases"
          ]
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "description": "command=subscribe: the target repo for action=add/remove/releases. command=run: with stages including 'releases', analyze only this repository's releases (absent = every subscribed repo)."
        },
        "volume": {
          "type": "integer",
          "minimum": 1,
          "description": "subscribe action=releases only: which volume of the repo's release document to read. Defaults to the newest volume."
        },
        "stages": {
          "type": "array",
          "description": "command=run only: which stages to execute. Absent means every enabled stage (backwards compatible); an explicit list narrows the run, e.g. ['releases'] for a release-only run.",
          "items": {
            "type": "string",
            "enum": [
              "trending",
              "digest",
              "releases"
            ]
          }
        }
      },
      "description": "Strict request envelope. command=subscribe manages the repo subscription list: action=list needs no repo; action=add/remove require exactly one repo; action=releases requires a repo and may name a volume. command=run may narrow its work with stages; when stages includes 'releases', repo optionally restricts the release analysis to a single repository.",
      "allOf": [
        {
          "if": {
            "properties": {
              "command": {
                "const": "subscribe"
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "enum": [
                  "list",
                  "add",
                  "remove",
                  "releases"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "action": {
                      "const": "list"
                    }
                  },
                  "required": [
                    "action"
                  ]
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "repo"
                        ]
                      },
                      {
                        "required": [
                          "volume"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "action": {
                      "enum": [
                        "add",
                        "remove"
                      ]
                    }
                  },
                  "required": [
                    "action"
                  ]
                },
                "then": {
                  "required": [
                    "repo"
                  ],
                  "not": {
                    "required": [
                      "volume"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "action": {
                      "const": "releases"
                    }
                  },
                  "required": [
                    "action"
                  ]
                },
                "then": {
                  "required": [
                    "repo"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "enum": [
                  "run"
                ]
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "action"
                  ]
                },
                {
                  "required": [
                    "volume"
                  ]
                }
              ]
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "repo"
                  ]
                },
                "then": {
                  "required": [
                    "stages"
                  ],
                  "properties": {
                    "stages": {
                      "contains": {
                        "const": "releases"
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "enum": [
                  "serve",
                  "config",
                  "version"
                ]
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "action"
                  ]
                },
                {
                  "required": [
                    "repo"
                  ]
                },
                {
                  "required": [
                    "volume"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "enum": [
                  "subscribe",
                  "serve",
                  "config",
                  "version"
                ]
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "not": {
              "required": [
                "stages"
              ]
            }
          }
        }
      ]
    },
    "RunResult": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "ipcSchema",
        "ok",
        "command",
        "startedAt",
        "finishedAt",
        "skipped",
        "files"
      ],
      "properties": {
        "ipcSchema": {
          "const": 3
        },
        "ok": {
          "type": "boolean"
        },
        "command": {
          "type": "string",
          "enum": [
            "run",
            "serve",
            "config",
            "version",
            "subscribe"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "skipped": {
          "type": "boolean"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileArtifact"
          }
        },
        "digest": {
          "$ref": "#/$defs/DigestArtifact"
        },
        "branch": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "prUrl": {
          "type": "string",
          "format": "uri"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "error": {
          "$ref": "#/$defs/ErrorInfo"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "releases": {
          "$ref": "releases.v2.json#/$defs/ReleasesReport"
        },
        "subscriptions": {
          "$ref": "releases.v2.json#/$defs/SubscriptionList"
        },
        "subscriptionDoc": {
          "$ref": "releases.v2.json#/$defs/SubscriptionDoc"
        }
      }
    },
    "Usage": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "promptTokens",
        "completionTokens",
        "totalTokens",
        "cachedTokens",
        "usageKnown",
        "calls",
        "retries",
        "batches",
        "cacheHits"
      ],
      "properties": {
        "promptTokens": {
          "type": "integer",
          "minimum": 0
        },
        "completionTokens": {
          "type": "integer",
          "minimum": 0
        },
        "totalTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cachedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "usageKnown": {
          "type": "boolean"
        },
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "batches": {
          "type": "integer",
          "minimum": 0
        },
        "cacheHits": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "StateRun": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "date",
        "contentHash",
        "runAt"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "contentHash": {
          "type": "string"
        },
        "outputDir": {
          "type": "string"
        },
        "runAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "State": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "ipcSchema",
        "stateSchema"
      ],
      "properties": {
        "ipcSchema": {
          "const": 3
        },
        "stateSchema": {
          "const": 3
        },
        "lastRun": {
          "$ref": "#/$defs/StateRun"
        }
      }
    }
  }
}
