{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/morehao/trendradar/contract/schema/digest.v2.json",
  "title": "trendradar digest v2",
  "description": "One day's rendered digest document. contentHash is stable across runs (generatedAt/coreVersion excluded); contentHashAlgo records which algorithm produced it.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "date", "period", "languages", "count", "degraded", "contentHash", "contentHashAlgo", "repos"],
  "properties": {
    "schema": { "const": 2 },
    "date": { "type": "string", "format": "date" },
    "period": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
    "languages": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "count": { "type": "integer", "minimum": 0 },
    "degraded": { "type": "boolean" },
    "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "contentHashAlgo": { "type": "string", "enum": ["jcs-sha256-v1", "legacy-struct-marshal-v1"] },
    "coreVersion": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "repos": {
      "type": "array",
      "items": { "$ref": "model.v2.json#/$defs/RepoDigest" }
    }
  }
}
