{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/morehao/trendradar/contract/schema/releases.v2.json",
  "title": "trendradar releases v2",
  "description": "Repo release subscription documents. ReleaseDigest is the rendered on-disk document; ReleasesReport is the per-run diagnostic carried in RunResult.releases. Token cost lives in ReleasesReport.usage (always present), never in ReleaseDigest, because cost is a property of one run and cannot be reproduced from a stored document. schema=2 adds the per-repo weekly batch summary (repos[].summaryZh + periodStart/periodEnd); the per-item summaryZh stays readable for old documents but is no longer written.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "date",
    "period",
    "contentHash",
    "contentHashAlgo",
    "count",
    "degraded",
    "repos"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "period": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly"
      ]
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contentHashAlgo": {
      "type": "string",
      "enum": [
        "jcs-sha256-v1"
      ]
    },
    "coreVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "degraded": {
      "type": "boolean"
    },
    "repos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RepoReleases"
      }
    }
  },
  "$defs": {
    "ReleaseItem": {
      "type": "object",
      "additionalProperties": true,
      "description": "One release or tag. kind distinguishes a GitHub release (has notes) from a tag fallback (commit message used as the summary basis). summaryZh is optional and no longer written by schema 2: the summary now lives once per repo per week in RepoReleases.summaryZh.",
      "required": [
        "id",
        "tag",
        "name",
        "kind",
        "url",
        "prerelease",
        "draft",
        "summarySource"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "x-go-type": "int64",
          "description": "GitHub release id; 0 when the item comes from a tag fallback."
        },
        "tag": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "release",
            "tag"
          ]
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "url": {
          "type": "string"
        },
        "prerelease": {
          "type": "boolean"
        },
        "draft": {
          "type": "boolean"
        },
        "bodyExcerpt": {
          "type": "string",
          "description": "Truncated raw release notes. Untrusted text: display only, never execute."
        },
        "summaryZh": {
          "type": "string",
          "description": "Legacy per-item summary. Still accepted so documents written before schema 2 stay readable; schema 2 writers leave it empty."
        },
        "summarySource": {
          "type": "string",
          "enum": [
            "model",
            "original"
          ]
        }
      }
    },
    "RepoReleases": {
      "type": "object",
      "additionalProperties": true,
      "description": "One repo's release batch for one summary period. summaryZh covers the whole week in a single model call; periodStart/periodEnd bound that week so a consumer can label it without parsing dates.",
      "required": [
        "fullName",
        "url",
        "latestTag",
        "newCount",
        "releases"
      ],
      "properties": {
        "fullName": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "latestTag": {
          "type": "string"
        },
        "newCount": {
          "type": "integer",
          "minimum": 0
        },
        "periodStart": {
          "type": "string",
          "format": "date"
        },
        "periodEnd": {
          "type": "string",
          "format": "date"
        },
        "summaryZh": {
          "type": "string",
          "description": "One Chinese summary for every version in this period. Empty when no summary was produced."
        },
        "releases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReleaseItem"
          }
        }
      }
    },
    "ReleasesReport": {
      "type": "object",
      "additionalProperties": true,
      "description": "Per-run diagnostic for the releases stage. usage, checked and changed are required and always serialized so a consumer can tell 'nothing spent / checked / changed' (0) from 'not reported' (missing). checked counts repos the stage examined; changed counts repos that produced a document write.",
      "required": [
        "enabled",
        "repos",
        "checked",
        "changed",
        "newReleases",
        "durationMs",
        "usage"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "repos": {
          "type": "integer",
          "minimum": 0
        },
        "checked": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "newReleases": {
          "type": "integer",
          "minimum": 0
        },
        "summarized": {
          "type": "integer",
          "minimum": 0
        },
        "degraded": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "rateLimited": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "integer",
          "minimum": 0
        },
        "historyTruncated": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "usage": {
          "$ref": "ipc.v3.json#/$defs/Usage"
        }
      }
    },
    "ReleaseManifestEntry": {
      "type": "object",
      "additionalProperties": true,
      "description": "One row of GET /api/v2/releases. Cost is intentionally absent: manifests describe stored documents, which carry no run cost.",
      "required": [
        "date",
        "period",
        "count",
        "contentHash"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "period": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "monthly"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "degraded": {
          "type": "boolean"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "SubscriptionStatus": {
      "type": "string",
      "description": "Per-repo check state of the most recent weekly release run: baseline (first sighting, no section written), ok (a week section was written), no_change (checked, nothing new), rate_limited / failed (check failed, cursor kept so the next run retries).",
      "enum": [
        "baseline",
        "ok",
        "no_change",
        "rate_limited",
        "failed"
      ]
    },
    "SubscriptionItem": {
      "type": "object",
      "additionalProperties": true,
      "description": "One row of the subscriptions table. Deliberately small: the full markdown lives behind SubscriptionDoc so the list stays under the first-paint payload budget.",
      "required": [
        "fullName",
        "status"
      ],
      "properties": {
        "fullName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "latestTag": {
          "type": "string"
        },
        "latestSummaryAt": {
          "type": "string",
          "format": "date",
          "description": "Date of the newest week section (its period end), used as the 'last summary' column."
        },
        "lastCheckedAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "$ref": "#/$defs/SubscriptionStatus"
        }
      }
    },
    "SubscriptionList": {
      "type": "object",
      "additionalProperties": true,
      "description": "Response of GET /api/v2/subscriptions and of the IPC subscribe list command. repos stays the only field old consumers read; items is the additive per-repo detail.",
      "required": [
        "repos"
      ],
      "properties": {
        "repos": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SubscriptionItem"
          }
        }
      }
    },
    "SubscriptionVolume": {
      "type": "object",
      "additionalProperties": true,
      "description": "One volume file of a repo's release document. Every volume is numbered: index N is <repo>-0N.md (zero padded), so the first volume is -01. from/to are the oldest/newest week bounds present in that file.",
      "required": [
        "index",
        "file"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "file": {
          "type": "string",
          "description": "Path relative to the releases document root (e.g. vercel/next.js-01.md)."
        },
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "SubscriptionDoc": {
      "type": "object",
      "additionalProperties": true,
      "description": "Response of the IPC subscribe releases command and of GET /api/v2/repos/{owner}/{repo}/releases. markdown is the exact file content: the panel renders it verbatim (single source of truth, no re-summarizing).",
      "required": [
        "fullName",
        "volume",
        "markdown"
      ],
      "properties": {
        "fullName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "volume": {
          "type": "integer",
          "minimum": 1
        },
        "volumes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SubscriptionVolume"
          }
        },
        "updatedAt": {
          "type": "string",
          "format": "date"
        },
        "markdown": {
          "type": "string"
        }
      }
    }
  }
}
