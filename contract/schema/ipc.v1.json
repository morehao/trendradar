{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/morehao/trendradar/contract/schema/ipc.v1.json",
  "title": "trendradar ipc v1",
  "description": "Envelope exchanged between the trendradar core binary and the DSH plugin. Only RunRequest forbids extra fields.",
  "oneOf": [
    { "$ref": "#/$defs/RunRequest" },
    { "$ref": "#/$defs/RunResult" }
  ],
  "$defs": {
    "ErrorCode": {
      "type": "string",
      "enum": [
        "INTERNAL",
        "CONFIG_INVALID",
        "PAYLOAD_TOO_LARGE",
        "FETCH_FAILED",
        "FETCH_RATE_LIMITED",
        "PARSE_FAILED",
        "MODEL_UNAUTHORIZED",
        "MODEL_RATE_LIMITED",
        "MODEL_TIMEOUT",
        "MODEL_FAILED",
        "MODEL_BAD_OUTPUT",
        "GIT_NOT_INSTALLED",
        "REPO_NOT_GIT",
        "REPO_DIRTY",
        "GIT_OPERATION_FAILED",
        "PR_FAILED",
        "NOT_MERGEABLE"
      ]
    },
    "ErrorInfo": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message", "retriable"],
      "properties": {
        "code": { "$ref": "#/$defs/ErrorCode" },
        "message": { "type": "string" },
        "retriable": { "type": "boolean" },
        "details": { "type": "object", "additionalProperties": true }
      }
    },
    "FileArtifact": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string" }
      }
    },
    "RunRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ipcSchema", "command"],
      "properties": {
        "ipcSchema": { "const": 1 },
        "command": { "type": "string", "enum": ["run", "serve", "config", "version"] },
        "configPath": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "dryRun": { "type": "boolean" },
        "outputDir": { "type": "string" }
      }
    },
    "RunResult": {
      "type": "object",
      "additionalProperties": true,
      "required": ["ipcSchema", "ok", "command", "startedAt", "finishedAt", "skipped", "files"],
      "properties": {
        "ipcSchema": { "const": 1 },
        "ok": { "type": "boolean" },
        "command": { "type": "string", "enum": ["run", "serve", "config", "version"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "skipped": { "type": "boolean" },
        "files": { "type": "array", "items": { "$ref": "#/$defs/FileArtifact" } },
        "error": { "$ref": "#/$defs/ErrorInfo" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "StateRun": {
      "type": "object",
      "additionalProperties": true,
      "required": ["date", "contentHash", "runAt"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "contentHash": { "type": "string" },
        "runAt": { "type": "string", "format": "date-time" }
      }
    },
    "State": {
      "type": "object",
      "additionalProperties": true,
      "required": ["ipcSchema"],
      "properties": {
        "ipcSchema": { "const": 1 },
        "lastRun": { "$ref": "#/$defs/StateRun" }
      }
    }
  }
}
